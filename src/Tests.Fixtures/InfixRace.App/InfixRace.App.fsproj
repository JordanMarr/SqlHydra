<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <!-- bin/<framework>/ whatever the configuration, so Tests.fsproj can find it. -->
    <OutputPath>bin/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="8.0.100" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Update="FSharp.Core" Version="9.0.201" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Update="FSharp.Core" Version="10.1.201" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SqlHydra.Query\SqlHydra.Query.fsproj" />
    <!-- Copied next to the app but not used from code, so it loads only when Program.fs asks. -->
    <ProjectReference Include="..\InfixRace.Late\InfixRace.Late.fsproj" />
  </ItemGroup>

</Project>
